# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Google Gemini (free key: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Model used by both architectures. Free tier is ~20 requests/day PER MODEL;
# switch to another model (e.g. gemini-2.5-flash-lite, gemini-2.5-flash) to get a fresh quota.
MODEL_NAME=gemini-3.1-flash-lite
# Optional tuning
# GEMINI_THINKING_LEVEL=minimal      # gemini-3 models
# GEMINI_THINKING_BUDGET=0           # gemini-2.5 models
# LLM_TEMPERATURE=                   # default: 0 for gemini-2.x, model default for gemini-3
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_ATTEMPTS=6
